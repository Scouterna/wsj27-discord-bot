node_modules/

# .env and every variant (.env.k8s holds the exported production secrets)
.env
.env.*
!.env.example

.DS_Store
*.log
data/claims.json

# Local npm registry override, used by the Docker build if present. Kept out of
# the image entirely: it is copied only into the dependency stage.
.npmrc

# Kubeconfigs hold long-lived service-account tokens; they live in ~/.kube
**/kubeconfig*
**/*.kubeconfig

# Claude Code local settings cache literal command strings, which can capture secrets
.claude/*.local.json
